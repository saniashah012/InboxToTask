# Study inbox sender (npm run study:send). Copy to Checkpoint 3/app/.env.study,
# which is git-ignored. Never commit real addresses or the app password.

# The dedicated Gmail "test sender" account. Every scripted email is sent from it.
STUDY_SENDER_ADDRESS=
# A Gmail app password for that account (needs 2-Step Verification). Spaces are ignored.
STUDY_SENDER_APP_PASSWORD=

# The only addresses the script will send to. --to A|B|C picks one.
STUDY_INBOX_A_ADDRESS=
STUDY_INBOX_B_ADDRESS=
# Spare inbox that can receive a copy of inbox A or B.
STUDY_INBOX_C_ADDRESS=
