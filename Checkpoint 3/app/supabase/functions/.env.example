# Copy to .env locally and fill values privately. Never commit real keys.
GEMINI_API_KEY=
# Explicitly select the previously evaluated model for this local trial.
GEMINI_MODEL=gemini-3.6-flash
ENABLE_FIXTURE_EXTRACTION=false
# Use the actual frontend origin. Missing Origin remains allowed for authenticated CLI clients.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_STORAGE_CLEANUP=false
SCHEDULER_SECRET=
