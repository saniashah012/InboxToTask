# Public browser configuration only. Never put service-role or Gemini keys here.
# Local Vite development tool only; cannot enable /storage in production builds.
VITE_STORAGE_ENABLED=false
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable only after provider configuration / backend migrations and functions.
VITE_GOOGLE_AUTH_ENABLED=false
VITE_GOOGLE_CONNECTION_ENABLED=false
# Shows Add to Google Calendar on tasks. The backend also needs ENABLE_CALENDAR_EVENTS=true.
VITE_CALENDAR_EVENTS_ENABLED=false
