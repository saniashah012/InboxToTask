# Copy to .env locally and fill values privately. Never commit real keys.
GEMINI_API_KEY=
# Explicitly select the previously evaluated model for this local trial.
GEMINI_MODEL=gemini-3.6-flash
ENABLE_FIXTURE_EXTRACTION=false
# Use the actual frontend origin. Missing Origin remains allowed for authenticated CLI clients.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_STORAGE_CLEANUP=false
SCHEDULER_SECRET=
# Separate client from sign-in; use separate Cloud projects for revocation isolation.
ENABLE_GOOGLE_CONNECTION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/google_callback
GOOGLE_RETURN_URL=http://127.0.0.1:5173/storage
# JSON map of key IDs to base64-encoded random 32-byte AES keys. Never commit keys.
GOOGLE_TOKEN_KEYS=
GOOGLE_TOKEN_ACTIVE_KEY=v1
