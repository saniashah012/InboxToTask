{
  "name": "inbox-to-task-pipeline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test ../tests/pipeline.test.mjs ../tests/supabase-endpoint.test.mjs ../tests/storage-database.test.mjs ../tests/storage.test.mjs ../tests/google-connection.test.mjs ../tests/google-database.test.mjs ../tests/scan-settings.test.mjs ../tests/gmail-retrieval.test.mjs ../tests/gmail-extraction.test.mjs ../tests/gmail-persistence.test.mjs",
    "test:google": "node --test ../tests/google-connection.test.mjs ../tests/google-database.test.mjs",
    "test:google:local": "node ../tests/google-local.mjs",
    "test:storage": "node --test ../tests/storage-database.test.mjs ../tests/storage.test.mjs",
    "test:local": "node ../tests/storage-local.mjs",
    "test:calendar": "node --experimental-strip-types --test ../tests/calendar-export.test.mjs ../tests/calendar-event.test.mjs ../tests/calendar-database.test.mjs",
    "supabase:prepare": "node pipeline/prepare-edge.mjs",
    "fixtures:cp2": "node pipeline/import-cp2.mjs",
    "extract:plan": "node pipeline/cli.mjs --all",
    "extract:live": "node pipeline/cli.mjs --live",
    "diagnose": "node pipeline/diagnose.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "supabase": "^3.0.0"
  }
}
